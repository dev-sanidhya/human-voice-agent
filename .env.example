# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Only needed for Hindi/Hinglish (--language hi|hinglish) - real streaming
# Hindi TTS. Without this, Hindi/Hinglish fall back to a free edge-tts
# voice automatically (slower, but no key required). Get a key at
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=

